  },
  "item": [
    {
      "name": "Get data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains user data\", function () {",
              "    const users = pm.response.json();",
              "    pm.expect(users).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test(\"Each user has id, name, and email\", function () {",
              "    const users = pm.response.json();",
              "    users.forEach(function(user) {",
              "        pm.expect(user).to.have.property('id');",
              "        pm.expect(user).to.have.property('name');",
              "        pm.expect(user).to.have.property('email');",
              "    });",
              "});",
              "",
              "// Extract first user's id and store in collection variable",
              "const users = pm.response.json();",
              "if (users && users.length > 0) {",
              "    pm.collectionVariables.set(\"userId\", users[0].id);",
              "    console.log(\"Stored userId:\", users[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users"
          ]
        },
        "description": "This is a GET request and it is used to \"get\" data from an endpoint. There is no request body for a GET request, but you can use query parameters to help specify the resource you want data on (e.g., in this request, we have `id=1`).\n\nA successful GET response will have a `200 OK` status, and should include some kind of response body - for example, HTML web content or JSON data."
